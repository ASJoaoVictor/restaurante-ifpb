{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/@fontsource/dm-sans/package.json",
          "node_modules/@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff",
          "node_modules/@fontsource/dm-sans/files/dm-sans-latin-700-normal.woff",
          "public/img/logo.png"
        ]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/public/uploads/(.*)",
      "dest": "src/main.ts",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    },
    {
      "src": "/api/public/(.*)",
      "dest": "public/$1"
    },
    {
      "src": "/api/?(.*)",
      "dest": "src/main.ts",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    }
  ]
}
