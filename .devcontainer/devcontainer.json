{
  "name": "Debian",
  "image": "mcr.microsoft.com/devcontainers/base:bullseye",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "nodeGypDependencies": true,
      "installYarnUsingApt": true,
      "version": "22",
      "pnpmVersion": "none",
      "nvmVersion": "latest"
    },
    "ghcr.io/meaningful-ooo/devcontainer-features/fish:2": {
      "fisher": true
    },
    "ghcr.io/shyim/devcontainers-features/bun:0": {},
    "ghcr.io/itsmechlark/features/postgresql:1": {
      "version": "17"
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "bash .devcontainer/create.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [3000, 5173, 4173],
  "portsAttributes": {
    "3000": {
      "label": "Back-end",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "Front-end (development)",
      "onAutoForward": "openBrowserOnce"
    },
    "4173": {
      "label": "Front-end (production)",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "containerEnv": {
    "DATABASE_URL": "postgres://postgres@localhost:5432/meals",
    "VITE_API_ENDPOINT": "https://${localEnv:CODESPACE_NAME}-3000.${localEnv:GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}",
    "JWT_SECRET": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bierner.markdown-preview-github-styles",
        "dbaeumer.vscode-eslint",
        "dotenv.dotenv-vscode",
        "esbenp.prettier-vscode",
        "GitHub.vscode-github-actions",
        "jock.svg",
        "keksiqc.idx-monospace-theme",
        "mhutchie.git-graph",
        "MS-vsliveshare.vsliveshare",
        "PKief.material-icon-theme",
        "rangav.vscode-thunder-client",
        "redhat.vscode-yaml",
        "stylelint.vscode-stylelint",
        "usernamehw.errorlens",
        "yoavbls.pretty-ts-errors"
      ]
    }
  }
}
