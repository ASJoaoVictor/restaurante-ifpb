{
  "name": "project-backend",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "dotenv -- node dist/src/main.js",
    "dev": "dotenv -- nest start --watch",
    "build": "nest build",
    "format": "prettier --write .",
    "lint": "eslint .",
    "db:migrations-gen": "drizzle-kit generate",
    "db:migrations-gen-empty": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "dotenv -- tsx src/seed.ts",
    "test": "npm run test:types && npm run test:unit && npm run test:e2e",
    "test:types": "tsc --noEmit",
    "test:unit": "dotenv -e .env.test.local -e .env.test -- jest",
    "test:e2e": "dotenv -e .env.test.local -e .env.test -- jest --config jest.e2e.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@nanogiants/nestjs-swagger-api-exception-decorator": "^1.7.2",
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@react-email/components": "^0.4.0",
    "@react-email/render": "^1.1.4",
    "@react-pdf/renderer": "^4.9.0",
    "@types/nodemailer": "^6.4.17",
    "@vercel/blob": "^2.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "classnames": "^2.5.1",
    "compression": "^1.8.1",
    "content-disposition": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "csv-stringify": "6.6.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "drizzle-seed": "^0.3.1",
    "envalid": "^8.1.0",
    "express": "^5.1.0",
    "google-auth-library": "^10.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.10",
    "lodash": "^4.17.21",
    "mime-types": "^3.0.2",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "node-schedule": "^2.1.1",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-filename": "^1.6.4",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@josejefferson/eslint-config-nest": "^2.1.0",
    "@josejefferson/eslint-config-react": "^2.1.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/mime-types": "^3.0.1",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.2.0",
    "@types/node-schedule": "^2.1.8",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.32.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
